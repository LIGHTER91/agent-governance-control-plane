# Local-only Docker Compose development values.
# Copy to .env if you want Docker Compose to pick them up automatically.

POSTGRES_DB=agent_governance_control_plane
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Container-to-container database URLs used by the API service.
AGCP_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/agent_governance_control_plane?connect_timeout=5
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/agent_governance_control_plane?connect_timeout=5

# Browser-visible backend URL used by the Next.js frontend.
NEXT_PUBLIC_AGCP_API_BASE_URL=http://localhost:8000

# Local browser origins allowed by the API during development.
AGCP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
